#!/bin/sh
# Add an unauthenticated /healthcheck for Railway. init-nginx regenerates the
# live config from /defaults/default.conf at boot and enables basic auth on
# everything when PASSWORD is set - patch both so init order is moot.
# awk, not sed: Alpine LSIO images ship busybox sed without GNU's 0,/re/ address.
for F in /defaults/default.conf /etc/nginx/sites-available/default /etc/nginx/http.d/default.conf; do
  [ -f "$F" ] || continue
  grep -q '/healthcheck' "$F" && continue
  awk '!d && /^  location / { print "  location = /healthcheck { auth_basic off; return 200 \"ok\"; }"; d=1 } { print }' "$F" > "$F.tmp" && mv "$F.tmp" "$F"
done
